# SportsOS environment configuration (Sprint 4 — persistence)
#
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# Only names and placeholders belong in this example file.

# --- Production database (REQUIRED for the production composition) ---
# PostgreSQL connection string used by the production persistence adapters.
# The production container fails to start if neither of these is set.
# DATABASE_URL takes precedence; SUPABASE_DB_URL is the provisioned fallback.
DATABASE_URL=
SUPABASE_DB_URL=

# --- Integration tests (OPTIONAL) ---
# Connection string for a DISPOSABLE, isolated PostgreSQL database with the
# Sprint 4 migrations applied. When unset, the PostgreSQL integration tests are
# SKIPPED (never faked, never pointed at production automatically).
TEST_DATABASE_URL=
